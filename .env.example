# Copie este arquivo para .env e preencha no servidor. Nunca coloque a chave no index.html.
PORT=3000
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Providers suportados:
# - openai -> usa Authorization: Bearer <token>
# - custom -> usa uma API compatível com OpenAI, com sua URL/modelo próprios
